{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT r.oracle_id, r.key AS \"key!\",\n                   to_char(r.published_at, 'YYYY-MM-DD') AS \"date!\"\n            FROM rulings r\n            JOIN UNNEST($1::uuid[], $2::text[]) AS w(oracle_id, key)\n              ON r.oracle_id = w.oracle_id AND r.key = w.key\n            ",
