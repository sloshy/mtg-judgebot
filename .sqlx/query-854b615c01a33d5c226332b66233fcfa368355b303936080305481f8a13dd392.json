  "query": "\n        SELECT outcome, count(*) AS \"runs!\"\n        FROM judge_runs\n        WHERE (finished_at AT TIME ZONE 'utc')::date >= (now() AT TIME ZONE 'utc')::date - $1::int\n        GROUP BY outcome\n        ORDER BY 2 DESC, 1\n        ",
