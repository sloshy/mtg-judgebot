  "query": "\n        SELECT id, parent_id, subsection, heading, body, examples, cr_version\n        FROM rules\n        WHERE parent_id IS NULL AND embedding IS NOT NULL AND id ~ '^[0-9]{3}\\.[0-9]+$'\n        ORDER BY embedding <=> $1\n        LIMIT $2\n        ",
