# Deploy credentials — copy to .env.deploy (gitignored) on the server only.
#
# Kept out of .env deliberately: .env is the env_file for `judgebot` (and
# `refresh`), and neither reads any of this. The API is anonymous and
# internet-facing, so a token that can rewrite the tunnel or delete every
# backup has no business in its environment. Only the `cloudflared` service,
# the `backup` service and scripts/backup-db.sh read this file, and the
# `backup` service reads nothing of .env.

# From the tunnel's "Install and run a connector" screen in Cloudflare Zero
# Trust. Read by the cloudflared container (COMPOSE_PROFILES=tunnel in .env).
TUNNEL_TOKEN=

# Weekly database backup to an S3-compatible store: the `backup` compose
# service (COMPOSE_PROFILES=...,backup in .env) or scripts/backup-db.sh from
# cron. Both read every setting below and write the same objects. Scope the
# key to reading and writing this one bucket. docs/DEPLOYMENT.md §6 has each
# provider's values:
#   Cloudflare R2  BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#                  (region auto, the default)
#   AWS S3         BACKUP_S3_ENDPOINT=https://s3.<region>.amazonaws.com
#                  BACKUP_S3_REGION=<region>  BACKUP_S3_ADDRESSING=virtual-hosted
#   Backblaze B2   BACKUP_S3_ENDPOINT=https://s3.<region>.backblazeb2.com
#                  BACKUP_S3_REGION=<region>, e.g. us-west-004
#   MinIO          BACKUP_S3_ENDPOINT=https://minio.example.lan:9000
#                  BACKUP_S3_REGION=us-east-1 (or its MINIO_REGION)
# Before 2.0.0 these were R2_BUCKET, R2_ENDPOINT, R2_ACCESS_KEY_ID and
# R2_SECRET_ACCESS_KEY, which are now refused: rename those lines, and do not
# add these blank ones as well (the last line of a name wins, a blank one too).
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# The region requests are signed for. Blank is auto, which Cloudflare R2
# takes; AWS and Backblaze B2 need the bucket's own.
BACKUP_S3_REGION=
# Where requests name the bucket: path (https://<endpoint>/<bucket>/..., the
# default, which every store above takes) or virtual-hosted
# (https://<bucket>.<endpoint host>/..., which AWS recommends; needs a bucket
# name without dots over https).
BACKUP_S3_ADDRESSING=

# Backups older than this are pruned after a successful upload, so weekly runs
# keep roughly BACKUP_KEEP_DAYS/7 restore points. The `backup` service never
# prunes the two newest, however old; the script has no such floor.
BACKUP_KEEP_DAYS=60
# Refuse to upload a dump smaller than this. The live database dumps to tens of
# MB; a stub means pg_dump hit an empty or half-started database, and must not
# become the newest restore point. Raise it as the corpus grows.
BACKUP_MIN_BYTES=20000000
# Object key prefix within the bucket.
BACKUP_PREFIX=db
# Where to keep a local copy after upload. Unset means the dump is deleted once
# it is uploaded. The script reads a host path; the `backup` service a path
# inside its container, which needs a mount there (docs/DEPLOYMENT.md §6).
BACKUP_KEEP_LOCAL=
# The `backup` service takes a backup whenever the newest in the bucket is this
# many days old (1 to 365); cron is the script's schedule. It checks hourly, so
# a restart does not reset the schedule and a cron'd backup counts.
BACKUP_EVERY_DAYS=7

# Optional: an https webhook (Discord, Slack or compatible) the `backup`
# service tells when a backup fails (once per streak, and again if it starts
# failing at another step) and when one succeeds
# after a failure, and the script when it fails. The service reads it only
# from here; judgebot reads it from .env, so set it in both files to hear
# from both. The URL is a credential: whoever has it can post to the channel.
JUDGE_ALERT_WEBHOOK=
