# Deploy credentials — copy to .env.deploy (gitignored) on the server only.
#
# Kept out of .env deliberately: .env is the env_file for `bot` and `api`, and
# neither reads any of this. The API is anonymous and internet-facing, so a
# token that can rewrite the tunnel or delete every backup has no business in
# its environment. Only the `cloudflared` service and scripts/backup-db.sh
# read this file.

# From the tunnel's "Install and run a connector" screen in Cloudflare Zero
# Trust. Read by the cloudflared container (COMPOSE_PROFILES=tunnel in .env).
TUNNEL_TOKEN=

# Weekly database backup (scripts/backup-db.sh). R2_ENDPOINT is
# https://<account-id>.r2.cloudflarestorage.com. Scope the R2 API token to
# Object Read & Write on this one bucket.
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Backups older than this are pruned after a successful upload, so weekly runs
# keep roughly BACKUP_KEEP_DAYS/7 restore points.
BACKUP_KEEP_DAYS=60
# Refuse to upload a dump smaller than this. The live database dumps to tens of
# MB; a stub means pg_dump hit an empty or half-started database, and must not
# become the newest restore point. Raise it as the corpus grows.
BACKUP_MIN_BYTES=20000000
# Object key prefix within the bucket.
BACKUP_PREFIX=db
# Where to keep the local copy after upload, so the restore drill has a file to
# work with. Unset means the dump is deleted when the script exits.
BACKUP_KEEP_LOCAL=
