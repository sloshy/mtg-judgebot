---
// Starlight's footer (edit link, pagination), then the Fan Content Policy
// statement and where the data comes from. Starlight renders the footer on the
// splash pages too, so this puts the statement on every page of the site. The
// web app's footer (web/src/App.tsx) says the same; keep the two in step.
import Default from "@astrojs/starlight/components/Footer.astro";
import { type LinkTo, localePath, messages, siteLocale } from "../i18n";

// The text is the page's language's (src/i18n.ts); the URLs are here.
const locale = siteLocale(Astro.locals.starlightRoute.locale);
const m = messages(locale);
const hrefs: Record<LinkTo, string> = {
  policy: "https://company.wizards.com/en/legal/fancontentpolicy",
  scryfall: "https://scryfall.com",
  yawgatog: "https://yawgatog.com/resources/magic-rules/",
  attribution: localePath(locale, "/reference/attribution/"),
};
---

<Default />
<div class="legal">
  {
    [m.fanContent, m.dataSources].map((parts) => (
      <p>
        {parts.map((part) =>
          typeof part === "string" ? part : <a href={hrefs[part.link]}>{part.label}</a>,
        )}
      </p>
    ))
  }
</div>

<style>
  .legal {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-hairline);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .legal p + p {
    margin-top: 0.5rem;
  }
  .legal a {
    color: var(--sl-color-gray-2);
  }
  .legal a:hover {
    color: var(--sl-color-white);
  }
</style>
