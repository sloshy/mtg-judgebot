---
// Starlight's header carries no navigation of its own, and the landing page is a
// splash (so it has no sidebar either): without this there is no way into the
// documentation from the front page except the hero buttons. Overriding
// SocialIcons is the supported place to put header links — it renders inside the
// header's right-hand group, which Starlight already hides on narrow viewports,
// where the sidebar's menu button does this job instead.
import SocialIcons from "@astrojs/starlight/components/SocialIcons.astro";
import { localePath, messages, siteLocale } from "../i18n";

// The label is the page's language's (src/i18n.ts), and so is the page it opens.
// "Docs", not "Documentation": at 108px the longer label clipped the site title
// on a 320px phone, where this link is the only navigation in the header.
const locale = siteLocale(Astro.locals.starlightRoute.locale);
const links = [
  { label: messages(locale).docs, href: localePath(locale, "/start-here/what-it-is/") },
];
const here = Astro.url.pathname.replace(/\/$/, "");
---

<nav class="header-links sl-flex" aria-label="Site">
  {
    links.map(({ label, href }) => (
      <a href={href} aria-current={here === href.replace(/\/$/, "") ? "page" : undefined}>
        {label}
      </a>
    ))
  }
</nav>
<SocialIcons />

<style>
  .header-links {
    gap: 1rem;
    align-items: center;
    font-size: var(--sl-text-sm);
  }
  .header-links a {
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }
  .header-links a:hover,
  .header-links a[aria-current="page"] {
    color: var(--sl-color-white);
  }
</style>
