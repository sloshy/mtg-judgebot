#!/usr/bin/env bash
# Formatting, lints and a warning-free clippy for what the commit touches,
# checked on the staged tree itself (scripts/check.sh --at <tree> --staged),
# so unstaged edits and untracked files cannot make it pass. Tests and the
# .sqlx check wait for pre-push. Installed by scripts/dev-setup.sh; skip once
# with `git commit --no-verify`.
root="$(git rev-parse --show-toplevel)"
tree="$(git write-tree)" || exit 1
exec "$root/scripts/check.sh" --at "$tree" --staged
