#!/usr/bin/env bash
# The CI gates on the tip of each ref being pushed (scripts/check.sh --at
# <sha>), whatever the working tree holds. Only what pre-commit leaves out
# runs (--since the remote's sha): the tests and the .sqlx check when Rust
# changed, which need Postgres up (`docker compose up -d db`). A new branch,
# or a remote commit
# this clone lacks (fetch first), gets every group. Skip once with
# `git push --no-verify`.
#
# `git config judgebot.scratchdb true` in a clone runs the hook against a
# throwaway Postgres container instead of the database .env or the shell's
# DATABASE_URL names (scripts/with-scratch-db.sh): for a host where that one
# serves an instance. A value git cannot read as a boolean refuses the push.
root="$(git rev-parse --show-toplevel)"
if [ -z "${JUDGEBOT_SCRATCH_DB:-}" ]; then
  scratch="$(git config --bool judgebot.scratchdb)"
  case $? in
    0 | 1) ;;
    *)
      echo "judgebot.scratchdb is not a boolean: fix it with \`git config judgebot.scratchdb true\`" >&2
      exit 1
      ;;
  esac
  if [ "$scratch" = true ]; then
    exec "$root/scripts/with-scratch-db.sh" "$0" "$@"
  fi
fi
zero="0000000000000000000000000000000000000000"
checked=" "
status=0
# git feeds one line per ref: <local ref> <local sha> <remote ref> <remote sha>.
while read -r _ local_sha _ remote_sha; do
  # A deleted ref pushes nothing; a sha seen for another ref is checked once.
  case "$local_sha" in "$zero" | "") continue ;; esac
  case "$checked" in *" $local_sha "*) continue ;; esac
  checked="$checked$local_sha "
  if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2> /dev/null; then
    echo "checking $local_sha (changes since $remote_sha)" >&2
    "$root/scripts/check.sh" --at "$local_sha" --since "$remote_sha" < /dev/null || status=1
  else
    echo "checking $local_sha (every group)" >&2
    "$root/scripts/check.sh" --at "$local_sha" < /dev/null || status=1
  fi
done
exit $status
