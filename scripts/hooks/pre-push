#!/usr/bin/env bash
# The CI gates on the tip of each ref being pushed (scripts/check.sh --at
# <sha>), whatever the working tree holds. Only the groups the push changes
# run (--since the remote's sha): the remote's commit got past these gates
# already. Changed Rust brings the tests and the .sqlx check, which need
# Postgres up (`docker compose up -d db`). A new branch, or a remote commit
# this clone lacks (fetch first), gets every group. Skip once with
# `git push --no-verify`.
root="$(git rev-parse --show-toplevel)"
zero="0000000000000000000000000000000000000000"
checked=" "
status=0
# git feeds one line per ref: <local ref> <local sha> <remote ref> <remote sha>.
while read -r _ local_sha _ remote_sha; do
  # A deleted ref pushes nothing; a sha seen for another ref is checked once.
  case "$local_sha" in "$zero" | "") continue ;; esac
  case "$checked" in *" $local_sha "*) continue ;; esac
  checked="$checked$local_sha "
  if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2> /dev/null; then
    echo "checking $local_sha (changes since $remote_sha)" >&2
    "$root/scripts/check.sh" --at "$local_sha" --since "$remote_sha" < /dev/null || status=1
  else
    echo "checking $local_sha (every group)" >&2
    "$root/scripts/check.sh" --at "$local_sha" < /dev/null || status=1
  fi
done
exit $status
