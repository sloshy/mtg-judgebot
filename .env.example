DATABASE_URL=postgres://judgebot:judgebot@localhost:5433/judgebot
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
DISCORD_TOKEN=
# Discord (crates/bot). Members holding a role named JUDGE_ROLE rate as judges
# (their score overrides crowd votes). Set GUILD_ID to register /judge in one
# guild instantly instead of globally (global registration can take an hour).
JUDGE_ROLE=Judge
GUILD_ID=
# Most /judge runs in flight at once; further ones get a "busy" reply.
JUDGE_CONCURRENCY=2
# HTTP API (crates/api) + web client. The api container serves the built
# SolidJS page from WEB_DIST and answers anonymously: per-IP rate limiting
# (API_RATE_LIMIT questions per API_RATE_WINDOW_SECS) protects API spend.
# Set API_TRUST_FORWARDED=true only behind a proxy that overwrites
# X-Forwarded-For.
API_ADDR=0.0.0.0:8787
WEB_DIST=web/dist
API_RATE_LIMIT=4
API_RATE_WINDOW_SECS=300
API_TRUST_FORWARDED=false
